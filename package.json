{
  "name": "didactic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "sh scripts/seed-dev.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9",
    "turbo": "^2.3.3",
    "typescript": "^5"
  }
}
