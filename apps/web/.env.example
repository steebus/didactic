NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Pictures drawn for a lesson (src/lib/llm/drawing.ts) are asked for
# through the AI Gateway below first (GATEWAY_IMAGE_MODEL, default
# openai/gpt-image-1.5), then OpenAI directly with this key -- which is
# not for embeddings, those run on the edge function. OpenAI will not
# draw with gpt-image-* for an unverified organisation, which is why the
# gateway goes first. With neither, a lesson is written exactly as it
# was before drawing existed.
OPENAI_API_KEY=
# The drawing switch, on by default (src/lib/features.ts). Set to `off`
# on Vercel and redeploy to pull it without a code change.
# FEATURE_DRAWN_PICTURES=off
# The image models, if not the defaults.
# GATEWAY_IMAGE_MODEL=openai/gpt-image-1.5
# OPENAI_IMAGE_MODEL=gpt-image-1

# Vercel AI Gateway, which is how ingestion reaches Jev -- the evaluation
# model that decides whether a concept is a topic the map already holds
# and which subjects it belongs under (src/lib/llm/jev.ts).
#
# Get one from the AI Gateway tab of the Vercel dashboard. On Vercel
# itself the OIDC token can stand in for it and no key is needed; locally
# there is no OIDC, so either set this or run `vercel env pull` and use
# the token it writes (which expires after twelve hours).
#
# Unset, every ingestion still files -- `ingest.judge` catches the throw
# and falls back to the embedding bands, and the inbox says it did. It
# files worse, and quietly enough that it is worth checking this is set
# before wondering why the queue has filled up.
#
# Also named in turbo.json: turbo runs tasks in strict env mode and
# passes on only what a task declares.
AI_GATEWAY_API_KEY=

# The shared secret between the ingestion worker and /api/internal/ingest.
#
# Invent it -- nothing issues this. Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# It is the only gate on that route. Everything else in the catalogue is
# behind the owner's session; the ingest route has none, because it is
# called by a worker rather than by a person, and it runs on the service
# role with row-level security bypassed. The route refuses every request
# when this is unset, so a deployment missing it files nothing at all.
#
# The SAME value has to be set in three places, or the worker and the
# route do not recognise each other:
#   - here, for local development
#   - Vercel's environment variables, for the deployed app
#   - the edge function's secrets, for the worker:
#       npx supabase secrets set INTERNAL_KEY=<value>
INTERNAL_KEY=
