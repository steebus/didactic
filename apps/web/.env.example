NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY no longer needed: embeddings run on the edge function

# The shared secret between the ingestion worker and /api/internal/ingest.
#
# Invent it -- nothing issues this. Any long random string will do:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# It is the only gate on that route. Everything else in the catalogue is
# behind the owner's session; the ingest route has none, because it is
# called by a worker rather than by a person, and it runs on the service
# role with row-level security bypassed. The route refuses every request
# when this is unset, so a deployment missing it files nothing at all.
#
# The SAME value has to be set in three places, or the worker and the
# route do not recognise each other:
#   - here, for local development
#   - Vercel's environment variables, for the deployed app
#   - the edge function's secrets, for the worker:
#       npx supabase secrets set INTERNAL_KEY=<value>
INTERNAL_KEY=
